{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handset",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "handset.mobilephonemuseum.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_APP_URL": "https://handset.mobilephonemuseum.com",
    "NEXT_PUBLIC_DIRECTUS_API": "https://cms.mobilephonemuseum.com"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
